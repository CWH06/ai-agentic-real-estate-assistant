# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Week 8 grounded answer generation. Set to `deepseek` or `openai`.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Used only when LLM_PROVIDER=openai
RAG_CHAT_MODEL=gpt-5.6-luna
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15
RAG_CANDIDATE_LIMIT=10000
RAG_EMBEDDINGS_BATCH_SIZE=50
RAG_REQUEST_TIMEOUT_MS=45000
# Optional; defaults to the repository's knowledge directory
# RAG_KNOWLEDGE_DIR=/absolute/path/to/knowledge

# Embeddings provider. Set to `voyage` or `openai`.
# If omitted, Voyage is used when VOYAGE_API_KEY is configured.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=idx_user
MYSQL_PASSWORD=replace-with-local-password
MYSQL_DATABASE=rets

# Week 11 email delivery. Gmail is used when EMAIL_SERVICE and EMAIL_HOST are omitted.
# Use an app password, not your normal account password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
# Optional provider settings
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_SECURE=true

# OpenClaw / channel configuration
OPENCLAW_ENV=development
WHATSAPP_CHANNEL=whatsapp

# Meta WhatsApp Cloud API
# Create a long random value and enter the same value in Meta webhook settings.
META_WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
META_WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
META_WHATSAPP_ACCESS_TOKEN=replace-with-your-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_PORT=3001

# Week 6 embedding indexing
EMBEDDINGS_PAGE_SIZE=100
EMBEDDINGS_BATCH_SIZE=50
# Optional; 0 means index all eligible active listings
EMBEDDINGS_INDEX_LIMIT=0
SEMANTIC_CANDIDATE_LIMIT=10000
RECOMMENDATION_CANDIDATE_LIMIT=1000
RECOMMENDATION_COMP_MONTHS=6
