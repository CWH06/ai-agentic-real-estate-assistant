# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Week 8 grounded answer generation. Set to `deepseek` or `openai`.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Used only when LLM_PROVIDER=openai
RAG_CHAT_MODEL=gpt-5.6-luna
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15
RAG_CANDIDATE_LIMIT=10000
RAG_EMBEDDINGS_BATCH_SIZE=50
RAG_REQUEST_TIMEOUT_MS=45000
# Optional; defaults to the repository's knowledge directory
# RAG_KNOWLEDGE_DIR=/absolute/path/to/knowledge

# Embeddings provider. Set to `voyage` or `openai`.
# If omitted, Voyage is used when VOYAGE_API_KEY is configured.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=idx_user
MYSQL_PASSWORD=replace-with-local-password
MYSQL_DATABASE=rets

# Email, used in later weeks
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# OpenClaw / channel configuration
OPENCLAW_ENV=development
WHATSAPP_CHANNEL=whatsapp

# Week 6 embedding indexing
EMBEDDINGS_PAGE_SIZE=100
EMBEDDINGS_BATCH_SIZE=50
# Optional; 0 means index all eligible active listings
EMBEDDINGS_INDEX_LIMIT=0
SEMANTIC_CANDIDATE_LIMIT=10000
RECOMMENDATION_CANDIDATE_LIMIT=1000
RECOMMENDATION_COMP_MONTHS=6
